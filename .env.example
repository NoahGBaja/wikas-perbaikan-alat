DATABASE_URL="mysql://user:password@localhost:3306/wikas_perbaikan_alat"
DATABASE_CONNECTION_LIMIT="10"
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_ORIGIN="http://localhost:3000"
SEED_PASSWORD=""

# local stores uploads outside public/. Use s3 for multi-instance production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".data/storage"

# Required when STORAGE_DRIVER=s3 (works with AWS S3 and compatible providers).
S3_BUCKET=""
S3_REGION="ap-southeast-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
