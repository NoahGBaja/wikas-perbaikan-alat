generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN_1
  ADMIN_2
  ADMIN_3
  ADMIN_4
  ADMIN_5
  USER
}

enum ReportCategory {
  FASILITAS_INVENTARIS
  IT_ELEKTRONIK
  LABORATORIUM
}

enum ReportSeverity {
  RINGAN
  SEDANG
  BERAT
}

enum ReportStatus {
  MENUNGGU_ADMIN_1
  MENUNGGU_ADMIN_2
  MENUNGGU_ADMIN_3
  MENUNGGU_ADMIN_4
  MENUNGGU_ADMIN_5
  DISETUJUI_FINAL
  DITOLAK
}

enum ReportDecisionAction {
  ACC
  TOLAK
}

model User {
  id           Int      @id @default(autoincrement())
  nama         String
  jabatan      String?
  nip          String?  @unique
  passwordHash String
  role         Role     @default(USER)
  isSuperAdmin Boolean  @default(false)
  categoryScope ReportCategory?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports             Report[]
  passwordResetTokens PasswordResetToken[]
  approvalHistories   ReportApprovalHistory[]
}

model Report {
  id                 Int            @id @default(autoincrement())
  userId             Int
  namaPelapor        String?
  nomorRuangan       String?
  kodeUakpb          String?
  kode               String?
  kategori           ReportCategory
  namaBarang         String
  lokasi             String
  deskripsi          String
  severity           ReportSeverity
  fotoUrl            String?
  attachmentUrl      String?
  attachmentType     String?
  attachmentName     String?
  status             ReportStatus   @default(MENUNGGU_ADMIN_1)
  alasanPenolakan    String?
  assignedTechnician String?
  adminNotes         String?
  completionNotes    String?
  completionPhotoUrl String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  processedAt        DateTime?
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories ReportApprovalHistory[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReportApprovalHistory {
  id         Int                  @id @default(autoincrement())
  reportId   Int
  adminId    Int
  action     ReportDecisionAction
  fromStatus ReportStatus
  toStatus   ReportStatus
  note       String?
  createdAt  DateTime             @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin  User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([adminId])
  @@index([reportId, createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
