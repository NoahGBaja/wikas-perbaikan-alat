generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN_1
  ADMIN_2
  ADMIN_3
  ADMIN_4
  ADMIN_5
  EXECUTIVE
  USER
}

enum ReportCategory {
  FASILITAS_INVENTARIS
  IT_ELEKTRONIK
  LABORATORIUM
}

enum ReportSeverity {
  RINGAN
  SEDANG
  BERAT
}

enum ReportStatus {
  MENUNGGU_ADMIN_1
  MENUNGGU_ADMIN_2
  MENUNGGU_ADMIN_3
  MENUNGGU_ADMIN_4
  MENUNGGU_ADMIN_5
  DISETUJUI_FINAL
  MENUNGGU_KONFIRMASI
  TELAH_BERFUNGSI
  TIDAK_DAPAT_DIGUNAKAN
  DITOLAK
}

enum ReportDecisionAction {
  ACC
  TOLAK
}

model User {
  id           Int      @id @default(autoincrement())
  nama         String
  jabatan      String?
  nip          String?
  activeNip    String?  @unique
  passwordHash String
  role         Role     @default(USER)
  isSuperAdmin Boolean  @default(false)
  categoryScope ReportCategory?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports             Report[]
  passwordResetTokens PasswordResetToken[]
  approvalHistories   ReportApprovalHistory[]
  notifications       Notification[]
}

model Report {
  id                 Int            @id @default(autoincrement())
  ticket             String?        @unique
  userId             Int
  namaPelapor        String?
  nomorRuangan       String?
  namaRuangan        String?
  kodeUakpb          String?
  kode               String?
  nup                String?
  kategori           ReportCategory
  subcategory        String?
  itemType           String?
  namaBarang         String
  lokasi             String
  deskripsi          String
  severity           ReportSeverity
  repairCost         Decimal?       @db.Decimal(14, 2)
  fotoUrl            String?
  attachmentUrl      String?
  attachmentType     String?
  attachmentName     String?
  status             ReportStatus   @default(MENUNGGU_ADMIN_1)
  alasanPenolakan    String?
  assignedTechnician String?
  adminNotes         String?
  completionNotes    String?
  completionPhotoUrl String?
  reporterConfirmed  Boolean        @default(false)
  reporterConfirmedAt DateTime?
  reporterConfirmationStatus String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  processedAt        DateTime?
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories      ReportApprovalHistory[]
  attachments    ReportAttachment[]
  notifications  Notification[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([ticket])
  @@index([kategori, createdAt])
}

model ReportAttachment {
  id        Int      @id @default(autoincrement())
  reportId  Int
  url       String
  fileType  String
  fileName  String
  fileSize  Int
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ReportApprovalHistory {
  id         Int                  @id @default(autoincrement())
  reportId   Int
  adminId    Int
  action     ReportDecisionAction
  fromStatus ReportStatus
  toStatus   ReportStatus
  note       String?
  createdAt  DateTime             @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin  User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([adminId])
  @@index([reportId, createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MasterCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories MasterSubcategory[]
}

model MasterSubcategory {
  id         Int      @id @default(autoincrement())
  categoryId Int
  code       String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category MasterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemTypes MasterItemType[]

  @@unique([categoryId, code])
}

model MasterItemType {
  id            Int      @id @default(autoincrement())
  subcategoryId Int
  code          String
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subcategory MasterSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, code])
}

model MasterRoom {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageTemplate {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  reportId  Int?
  title     String
  message   String   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([reportId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  reportId    Int?
  entityType  String
  entityId    String?
  action      String
  summary     String   @db.Text
  metadata    String?  @db.LongText
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([reportId])
  @@index([entityType, action])
  @@index([createdAt])
}
